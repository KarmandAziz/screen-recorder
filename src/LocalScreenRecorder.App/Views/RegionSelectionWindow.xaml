<Window x:Class="LocalScreenRecorder.App.Views.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseRightButtonDown="OnMouseRightButtonDown">
    <Canvas x:Name="OverlayCanvas" ClipToBounds="True">
        <Path x:Name="DimPath" Fill="#A6000000" IsHitTestVisible="False" />
        <Rectangle x:Name="SelectionRectangle"
                   Visibility="Collapsed"
                   Stroke="#FF60A5FA"
                   StrokeThickness="2"
                   Fill="#08000000" />
        <Border x:Name="SizeBadge"
                Visibility="Collapsed"
                Background="#F21F2937"
                CornerRadius="4"
                Padding="8,4">
            <TextBlock x:Name="SizeText" Foreground="White" FontWeight="SemiBold" />
        </Border>
        <Border Background="#E61F2937" CornerRadius="6" Padding="14,9"
                Canvas.Left="20" Canvas.Top="20">
            <StackPanel>
                <TextBlock Foreground="White" FontSize="14" FontWeight="SemiBold"
                           Text="Select an area to record" />
                <TextBlock Foreground="#FFD1D5DB" Margin="0,3,0,0"
                           Text="Drag anywhere across your displays · Esc or right-click to cancel" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
