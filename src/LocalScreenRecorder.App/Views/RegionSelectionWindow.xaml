<Window x:Class="LocalScreenRecorder.App.Views.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#B3000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseLeftButtonUp">
    <Canvas x:Name="OverlayCanvas" ClipToBounds="True">
        <Rectangle x:Name="SelectionRectangle"
                   Visibility="Collapsed"
                   Stroke="#FF60A5FA"
                   StrokeThickness="2"
                   Fill="#22000000" />
        <Border x:Name="SizeBadge"
                Visibility="Collapsed"
                Background="#F21F2937"
                CornerRadius="4"
                Padding="8,4">
            <TextBlock x:Name="SizeText" Foreground="White" FontWeight="SemiBold" />
        </Border>
        <Border Background="#E61F2937" CornerRadius="6" Padding="14,9"
                Canvas.Left="20" Canvas.Top="20">
            <TextBlock Foreground="White" FontSize="14"
                       Text="Drag to select an area  •  Esc to cancel" />
        </Border>
    </Canvas>
</Window>
