<Window x:Class="LocalScreenRecorder.App.Views.RecordingIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="204" Height="48"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False">
    <Border Background="#EE111827" BorderBrush="#44374151" BorderThickness="1"
            CornerRadius="8" Padding="12,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StateDot" Width="10" Height="10" Fill="#FFEF4444" Margin="0,0,9,0" />
            <TextBlock Grid.Column="1" x:Name="StateText" Text="Recording" Foreground="White" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" x:Name="ElapsedText" Text="00:00" Foreground="#FFD1D5DB"
                       FontFamily="Consolas" FontWeight="SemiBold" Margin="12,0,0,0" />
        </Grid>
    </Border>
</Window>
